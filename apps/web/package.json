{
  "name": "study-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "description": "Study system web app: resource launcher, flashcards, Feynman notes and decks, served by the Go middleware",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -noEmit -skipLibCheck && vite build",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@lucide/vue": "^1.62.0",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "pinia": "^2.1.7",
    "reka-ui": "^2.11.0",
    "reveal.js": "^6.0.2",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.4.0",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.11.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.4.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.0"
  }
}
