# Local Pi runtime state
.atl/

# Secrets. Real environment files are never committed; the documented template
# is .env.example, which is.
.env
.env.local
.env.*.local

# Everything under data/ is local: the SQLite database, its WAL sidecars, the
# stored source PDFs, and the generated Markdown. Never committed. The .gitkeep
# is the one exception, so the directory itself stays in the tree.
apps/go-middleware/data/*
!apps/go-middleware/data/.gitkeep

# A `data` directory moved aside to start from zero. Same content as `data/`,
# so the same rule applies: never committed.
apps/go-middleware/data.bak-*/

# Build artifacts
apps/go-middleware/bin/
*.test
